NPM_TOKEN=

# Shopify Files storage
SHOPIFY_STORE_URL=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-10

# Shared queue / job state
# Vercel Upstash/KV integration also works with KV_REST_API_URL + KV_REST_API_TOKEN
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# GitHub Actions worker trigger.
# Add these to Vercel so the app can start the audit-worker workflow on demand.
GITHUB_ACTIONS_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
# Optional; defaults to audit-queued and must match .github/workflows/audit-worker.yml
# GITHUB_DISPATCH_EVENT=audit-queued

# Set to false when running `npm run worker` next to `npm run dev`
# AUDIT_PROCESS_IN_API=false

# Docker: web is default. Worker machine must set APP_ROLE=worker so the
# container starts the audit worker (and pulls the latest audit-kit on boot).
# APP_ROLE=worker
# Skip the boot-time kit update with AUDIT_KIT_AUTO_UPDATE=false

# Session gate and first admin
# AUTH_SECRET signs login cookies. Generate with: openssl rand -base64 32
# ADMIN_EMAIL / ADMIN_PASSWORD create the first admin on first boot
# On Vercel, add AUTH_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD, and the Upstash Redis
# vars for Production and Preview, then redeploy
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email for user invites and password resets.
# Gmail: enable 2-Step Verification, create a Google App Password, and use that
# 16-character app password as SMTP_PASS. Do not use your normal Gmail password.
APP_BASE_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

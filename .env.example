NPM_TOKEN=

# Shopify Files storage
SHOPIFY_STORE_URL=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-10

# Shared queue / job state
# Vercel Upstash/KV integration also works with KV_REST_API_URL + KV_REST_API_TOKEN
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set to false when running `npm run worker` next to `npm run dev`
# AUDIT_PROCESS_IN_API=false

# Session gate and first admin
# AUTH_SECRET signs login cookies. Generate with: openssl rand -base64 32
# ADMIN_EMAIL / ADMIN_PASSWORD create the first admin on first boot
# On Vercel, add AUTH_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD, and the Upstash Redis
# vars for Production and Preview, then redeploy
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
